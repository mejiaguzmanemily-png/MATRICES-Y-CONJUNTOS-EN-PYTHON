#EJERCICIO 2: ANALISIS DE PARTICIPACION EN CURSOS 
curso_A = {"Ana", "Carlos", "Laura", "Pedro", "Sofia", "Andres", "Camila"}
curso_B = {"Laura", "Pedro", "Daniel", "Sofia", "Mateo", "Valentia"}
print("1. ESTUDIANTES INSCRITOS EN CADA CURSO ")
print(f"Curso A (Fundamentos de programación): {curso_A}")
print(f"Curso B (Introducción a bases de datos): {curso_B}")
print()
todos_estudiantes = curso_A.union(curso_B)
print("2. Total de estudiantes diferentes ")
print(f"Cantidad total de estudiantes: {len(todos_estudiantes)}")
print(f"Listado completo: {todos_estudiantes}")
print()
ambos_cursos = curso_A.intersection(curso_B)
print("3. Estudiantes en ambos cursos ")
print(f"Listado: {ambos_cursos}")
print()
solo_curso_a = curso_A.difference(curso_B)
print("4. Estudiantes unicamente en el curso A ")
print(f"Listado: {solo_curso_a}")
print()
solo_curso_b = curso_B.difference(curso_A)
print("5. Estudiantes unicamente en el curso B")
print(f"Listado: {solo_curso_b}")
print()
exactamente_uno = curso_A.symmetric_difference(curso_B)
print("6. Estudiantes en exactamente un curso")
print(f"Listado: {exactamente_uno}")
print()
a_en_b = curso_A.issubset(curso_B)
print("7. Todos los del curso A estan en el curso B? ")
print(f"Resultado: {a_en_b}")
print("8. Agregar un nuevo estudiante ")
print("Cursos actuales: ")
print(f"Curso A: {curso_A}")
print(f"Curso B: {curso_B}")
print()
curso_elegido = input("\nA que curso desea agregar el estudiante? (A o B): ").strip().upper()
nuevo_estudiante = input("Ingrese el nombre del nuevo estudiante: ").strip().capitalize()
if curso_elegido == "A": 
    curso_A.add(nuevo_estudiante)
    print(f"\n{nuevo_estudiante} fue agregado al Curso A")
elif curso_elegido == "B": 
    curso_B.add(nuevo_estudiante)
    print(f"\n{nuevo_estudiante} fue agregado al Curso B")
else: 
    print("\nOpcion no válida. Debe elegir A o B")

print("\n Resultados actualizados ")
print(f"Curso A: {curso_A}")
print(f"Curso B: {curso_B}")
print(f"Total de estudiantes: {len(curso_A.union(curso_B))}")
print(f"Estudiantes en ambos cursos: {curso_A.intersection(curso_B)}")
